  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch --clear-screen=false server/index.ts",
    "dev:ngrok": "cross-env NGROK_MODE=true NODE_ENV=development tsx watch --clear-screen=false server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:server": "esbuild server/index.prod.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/index.js",
    "build:client": "vite build",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:refresh": "drizzle-kit refresh",
    "setup": "npm install && npm run db:push"
  },
