# Core server configuration
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SESSION_SECRET=replace-with-a-long-random-value

# Local app URL. Replace these three values with the Render service URL in
# Render's environment settings (with no trailing slash).
FRONTEND_URL=http://localhost:5000
BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# AI providers
ANTHROPIC_API_KEY=
# A non-empty value is required at startup. A placeholder is sufficient only
# for UI/non-AI local tests; use a real key for calling AI/voice/VSL features.
OPENAI_API_KEY2=local-test-placeholder
OPENAI_WEBHOOK_SIGNING_SECRET=

# Email (SendGrid API key is stored in EMAIL_PASSWORD by this project)
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TOKEN_SECRET=

# Optional integrations
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
NOTION_INTEGRATION_SECRET=
NOTION_PAGE_URL=
ENCRYPTION_KEY=
